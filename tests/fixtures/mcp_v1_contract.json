    "protocol": "2025-11-25",
    "capture": "Independent installed client and baseline server over stdio; fixture paths and JSON text whitespace normalized."
  },
  "tools": [
    {
      "name": "compare_metrics",
      "description": "Delta digest of one unit across two reports — the measure->edit->measure tool.\n\nAfter changing code and re-profiling, call this with A = the before report\nand B = the after report: each metric comes back as {a, b, delta, delta_pct}\nwith ``delta = b - a`` (negative duration_us delta = B is faster). ``kernel``\nmatches in BOTH reports unless ``kernel_b`` overrides the B-side (renamed or\nrestructured kernels). Comparing two DIFFERENT kernels of one report (pass\nthe same path twice) is also legitimate. A metric missing on either side\nyields delta = 'not_available_in_this_export' — never a fake 0.0.\n",
      "inputSchema": {
        "properties": {
          "report_a": {
            "title": "Report A",
            "type": "string"
          },
          "report_b": {
            "title": "Report B",
            "type": "string"
          },
          "format": {
            "title": "Format",
            "type": "string"
          },
          "kernel": {
            "title": "Kernel",
            "type": "string"
          },
          "kernel_b": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Kernel B"
          },
          "metrics": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Metrics"
          }
        },
        "required": [
          "report_a",
          "report_b",
          "format",
          "kernel"
        ],
        "title": "compare_metricsArguments",
        "type": "object"
      }
    },
    {
      "name": "expand",
      "description": "Lazy raw access — the safety valve when the digest is not enough.\n\nReturns raw vendor metrics for one unit, filtered by a case-insensitive\nsubstring over vendor metric names (e.g. 'dram', 'stall', 'cache').\n``section='all'`` returns everything (large). Use this instead of ever\nreading the report file directly.\n",
      "inputSchema": {
        "properties": {
          "report_ref": {
            "title": "Report Ref",
            "type": "string"
          },
          "format": {
            "title": "Format",
            "type": "string"
          },
          "kernel": {
            "title": "Kernel",
            "type": "string"
          },
          "section": {
            "title": "Section",
            "type": "string"
          }
        },
        "required": [
          "report_ref",
          "format",
          "kernel",
          "section"
        ],
        "title": "expandArguments",
        "type": "object"
      }
    },
    {
      "name": "get_metrics",
      "description": "Compact numeric digest for one unit, in standard hardware/runtime terms.\n\n``metrics=None`` returns the backend's default core set. A metric the export\ndoes not contain is returned as 'not_available_in_this_export' — honest\nabsence, never zero. ``kernel`` accepts an exact name, a unique substring, or\nan index. The vocabulary is domain-appropriate: GPU terms (dram_pct_peak,\nachieved_occupancy) for kernels/passes, CPU terms (ipc, llc_miss_rate,\nself_pct) for cpu_function units.\n",
      "inputSchema": {
        "properties": {
          "report_ref": {
            "title": "Report Ref",
            "type": "string"
          },
          "format": {
            "title": "Format",
            "type": "string"
          },
          "kernel": {
            "title": "Kernel",
            "type": "string"
          },
          "metrics": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Metrics"
          }
        },
        "required": [
          "report_ref",
          "format",
          "kernel"
        ],
        "title": "get_metricsArguments",
        "type": "object"
      }
    },
    {
      "name": "list_kernels",
      "description": "List every profiled unit in a report (name, index, duration_us, domain).\n\nWorks for any backend's ``format`` on any host (tier-1, never platform-gated):\n'ncu-rep'/'ncu-csv' (NVIDIA kernels), 'rocprof-csv' (AMD kernels),\n'perf-stat-json'/'perf-report' (CPU functions), 'metal-trace' (Metal passes).\nCall this first to pick the hottest unit by duration_us.\n",
      "inputSchema": {
        "properties": {
          "report_ref": {
            "title": "Report Ref",
            "type": "string"
          },
          "format": {
            "title": "Format",
            "type": "string"
          }
        },
        "required": [
          "report_ref",
          "format"
        ],
        "title": "list_kernelsArguments",
        "type": "object"
      },
      "outputSchema": {
        "properties": {
          "result": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Result",
            "type": "array"
          }
        },
        "required": [
          "result"
        ],
        "title": "list_kernelsOutput",
        "type": "object"
      }
    },
    {
      "name": "platform_capabilities",
      "description": "What this host can DIGEST (everything) vs CAPTURE (gated) — call before profiling.\n\nReturns the machine identity plus two lists: ``can_digest`` (universal — any\nbackend with an installed reader, so a GPU-less host is still a first-class\ndigester of reports captured elsewhere) and ``can_capture_here`` (gated by\nOS + tool presence). Use it to avoid spending context on a capture that cannot\nrun here — e.g. CUDA on a Mac is not capturable but is fully digestable.\n",
      "inputSchema": {
        "properties": {},
        "title": "platform_capabilitiesArguments",
        "type": "object"
      }
    },
    {
      "name": "suggest_profile_command",
      "description": "The correct, platform-aware profiler invocation for ``target`` — or a refusal.\n\n``backend`` is a registered name ('nsight','rocm','linux_perf','metal'). If\ncapturable here, returns the exact command (POSIX/PowerShell/WSL-aware). If\nnot (wrong OS / missing tool), refuses and redirects to the tier-1 path:\ncapture on a host that supports it, then digest the report here.\n",
      "inputSchema": {
        "properties": {
          "backend": {
            "title": "Backend",
            "type": "string"
          },
          "target": {
            "title": "Target",
            "type": "string"
          }
        },
        "required": [
          "backend",
          "target"
        ],
        "title": "suggest_profile_commandArguments",
        "type": "object"
      }
    },
    {
      "name": "summarize_report",
      "description": "The N hottest units + their core metrics in ONE call — start here.\n\nReplaces the list_kernels + N x get_metrics round trips when orienting in an\nunfamiliar report. Units are ranked by duration_us, falling back to self_pct\n(CPU sampler symbols carry no wall time), then file order. When durations\nexist, ``coverage_pct_of_total_duration`` says how much of the report's total\ntime the returned units account for. Same honesty rule as get_metrics:\n'not_available_in_this_export' is NOT MEASURED, never zero.\n",
      "inputSchema": {
        "properties": {
          "report_ref": {
            "title": "Report Ref",
            "type": "string"
          },
          "format": {
            "title": "Format",
            "type": "string"
          },
          "top_n": {
            "default": 5,
            "title": "Top N",
            "type": "integer"
          },
          "metrics": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Metrics"
          }
        },
        "required": [
          "report_ref",
          "format"
        ],
        "title": "summarize_reportArguments",
        "type": "object"
      }
    }
  ],
